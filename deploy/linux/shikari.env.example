# Shikari team-server configuration (installed to /etc/shikari/shikari.env).
# Read by the systemd unit. Change values here, then: systemctl restart shikari

# Where Shikari keeps its data, database and bespoke config (NOT the code).
# Must match ReadWritePaths in the unit and be owned by the shikari user.
SHIKARI_HOME=/var/lib/shikari

# Bind address. Use 127.0.0.1 when a reverse proxy terminates TLS in front of Shikari
# (recommended); use 0.0.0.0 to serve directly on the network.
SHIKARI_HOST=127.0.0.1

# Port. 32453 by default. Binding < 1024 directly needs CAP_NET_BIND_SERVICE in the unit;
# prefer a reverse proxy on 443 forwarding here.
SHIKARI_PORT=32453

# Keep this at 1. Shikari holds session, lab-job and in-browser-console state in-process,
# so more than one worker would break reconnect and job polling.
SHIKARI_WORKERS=1
