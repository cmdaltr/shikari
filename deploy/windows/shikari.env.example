# Shikari team-server configuration (installed to %ProgramData%\Shikari\shikari.env).
# Read by the Windows service (shikari.win_service). Change values here, then restart the
# service: Restart-Service Shikari

# Where Shikari keeps its data, database and bespoke config (NOT the code). install.ps1 sets
# this to the -DataDir it installed to (default below); the service uses it as its working
# directory, so it must be a valid, writable Windows path.
SHIKARI_HOME=C:\ProgramData\Shikari

# Bind address. Use 127.0.0.1 when a reverse proxy terminates TLS in front of Shikari
# (recommended); use 0.0.0.0 to serve directly on the network.
SHIKARI_HOST=127.0.0.1

# Port. 32453 by default. Put a reverse proxy on 443 forwarding here.
SHIKARI_PORT=32453

# Keep this at 1. Shikari holds session, lab-job and in-browser-console state in-process,
# so more than one worker would break reconnect and job polling.
SHIKARI_WORKERS=1
