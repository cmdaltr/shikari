# macOS
.DS_Store
.AppleDouble
.LSOverride

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
*.egg-info/
dist/
*.egg

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.claude/

# Project specific
.temp/
*.log
archer/mappings/*.json
prompt.txt

# Sensitive data - NEVER commit these
*.db
*.sqlite
*.sqlite3
data/*.db
data/*.sqlite
.env
*.key
*.pem
profile_pictures/

# Output directories - keep structure but exclude generated content
data/correlate/*.json
!data/correlate/*_example*.json
data/generate/*.yaml
!data/generate/*_example.yaml
data/hunt/*.yaml
!data/hunt/*_example.yaml
data/progress/*.json
data/progress/*.lock
!data/progress/.gitkeep
data/profiles/*.json
!data/profiles/.gitkeep

# Cache directory for MITRE ATT&CK data
archer/data/cache/*
!archer/data/cache/.gitkeep

# Query examples repository (downloaded from GitHub)
archer/data/query_examples/*
!archer/data/query_examples/.gitkeep
!archer/data/query_examples/README.md

# Uploads directory (user-uploaded files and extractions)
data/uploads/*
!data/uploads/.gitkeep
!data/uploads/*_template.json

# Emulation output (runtime generated files)
data/emulation/*.json
!data/emulation/*_example.json
data/emulation/evidence/*
!data/emulation/evidence/.gitkeep

# Atomic Red Team (static data - git submodule in archer/data/emulation/)
archer/data/emulation/atomic-red-team/

# VECTR output (optional feature)
data/vectr/*.json
!data/vectr/*_example.json
data/vectr/campaigns/*
!data/vectr/campaigns/.gitkeep
data/vectr/exports/*
!data/vectr/exports/.gitkeep

# Test coverage
.coverage
htmlcov/
.pytest_cache/
.tox/
.hypothesis/

# Jupyter
.ipynb_checkpoints/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json
