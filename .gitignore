# Output directories - keep structure but exclude generated content
data/correlate/*.json
!data/correlate/*_example*.json
data/generate/*.yaml
!data/generate/*_example.yaml
data/hunt/*.yaml
!data/hunt/*_example.yaml
data/progress/*.json
!data/progress/.gitkeep

# Cache directory for MITRE ATT&CK data
archer/data/cache/*
!archer/data/cache/.gitkeep

# Emulation output (runtime generated files)
data/emulation/*.json
!data/emulation/*_example.json
data/emulation/evidence/*
!data/emulation/evidence/.gitkeep

# Atomic Red Team (static data - git submodule in archer/data/emulation/)
archer/data/emulation/atomic-red-team/

# VECTR output (optional feature)
data/vectr/*.json
!data/vectr/*_example.json
data/vectr/campaigns/*
!data/vectr/campaigns/.gitkeep
data/vectr/exports/*
!data/vectr/exports/.gitkeep

