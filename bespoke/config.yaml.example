# Bespoke Organization Configuration
# Copy this file to config.yaml and customize for your environment

# Organization information
organization:
  name: "Your Organization"

  # Default Splunk index (used when generating Splunk queries)
  default_index: "main"

  # Default Splunk sourcetype
  default_sourcetype: "WinEventLog:Security"

  # Default MDE/KQL timespan
  default_timespan: "1h"

# Field name overrides
# Map standard field names to your environment's custom field names
# This is useful if your log sources use non-standard field names
field_overrides:
  # Process fields
  # CommandLine: "process.command_line"
  # ProcessName: "process.name"
  # ParentProcessName: "process.parent.name"

  # User fields
  # AccountName: "user.name"
  # AccountDomain: "user.domain"

  # Network fields
  # RemoteIP: "destination.ip"
  # RemotePort: "destination.port"

  # File fields
  # FileName: "file.name"
  # FilePath: "file.path"

# Query generation settings
query_settings:
  # Whether to automatically apply exclusions to generated queries
  apply_exclusions: true

  # Maximum results to return (for queries that support limits)
  max_results: 1000

  # Default time range for queries
  default_timespan: "1h"

  # Whether to add comments explaining exclusions
  add_exclusion_comments: true

  # Severity threshold for including detections (1-5, 1=lowest)
  min_severity: 1

# Platform-specific settings
platforms:
  splunk:
    # Add earliest/latest time modifiers
    add_time_modifiers: true
    # Default time format
    time_format: "-1h"

  mde:
    # Use DeviceProcessEvents vs DeviceEvents
    prefer_process_events: true

  elastic:
    # Default index pattern
    index_pattern: "logs-*"

# ---------------------------------------------------------------------------
# LLM Configuration (for --llm mode in shikari console / shikari offline generate)
# ---------------------------------------------------------------------------
# Provider options: anthropic | openai | azure | copilot | local
#
# You can configure here OR use environment variables (env vars take
# precedence if no provider is set here).
#
# Environment variable alternatives:
#   Anthropic:    ANTHROPIC_API_KEY
#   OpenAI:       OPENAI_API_KEY
#   Azure OpenAI: AZURE_OPENAI_KEY + AZURE_OPENAI_ENDPOINT + AZURE_OPENAI_DEPLOYMENT
#   Local:        LLM_ENDPOINT

llm:
  # --- Option 1: Anthropic Claude ---
  # provider: anthropic
  # api_key: "sk-ant-..."
  # model: "claude-sonnet-5-5"
  # max_tokens: 4096

  # --- Option 2: OpenAI / ChatGPT Enterprise ---
  # provider: openai
  # api_key: "sk-..."
  # model: "gpt-4o"
  # max_tokens: 4096
  # base_url: "https://api.openai.com"  # Change for ChatGPT Enterprise

  # --- Option 3: Azure OpenAI / Microsoft Copilot ---
  # provider: azure
  # api_key: "your-azure-openai-key"
  # endpoint: "https://your-resource.openai.azure.com"
  # deployment: "gpt-4o"                # Your deployment name
  # api_version: "2024-06-01"

  # --- Option 4: Local / Self-hosted (Ollama, vLLM, LiteLLM, etc.) ---
  # provider: local
  # endpoint: "http://localhost:11434"   # Ollama default
  # model: "llama3"
  # max_tokens: 4096

# ---------------------------------------------------------------------------
# CALDERA (Emulate → Lab → CALDERA operations; docs/guide/25-caldera.md)
# ---------------------------------------------------------------------------
# Your lab's CALDERA server, as an instance-wide default. Most users set this per account in
# Profile -> API Keys -> Emulation Tools instead (the key encrypted per user). This file is the
# shared fallback; CALDERA_URL and CALDERA_API_KEY in the environment override both.
# The key is only ever sent in CALDERA's KEY header.
#
# caldera:
#   url: "https://caldera.lab:8888"
#   api_key: "your-caldera-red-api-key"
#   verify_tls: true

# Custom detection categories to prioritize
# Detections matching these categories will be highlighted
priority_categories:
  - "Credential Access"
  - "Lateral Movement"
  - "Execution"

# Environment-specific tags to add to generated queries
# These can help identify where queries came from
tags:
  environment: "production"
  team: "security-operations"
  # custom_tag: "value"
