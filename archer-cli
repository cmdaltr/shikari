#!/usr/bin/env bash
# archer-cli: Archer's one command: the server (and Ollama), the console, preview, MCP and the
# offline pipeline. `./archer-cli install` links this file into ~/bin. The work is in archer/service.py.
set -euo pipefail

self="${BASH_SOURCE[0]}"
while [[ -L "$self" ]]; do
  target="$(readlink "$self")"
  [[ "$target" == /* ]] && self="$target" || self="$(dirname "$self")/$target"
done
ROOT="$(cd "$(dirname "$self")" && pwd)"

PY="$ROOT/.venv/bin/python"
[[ -x "$PY" ]] || PY="$(command -v python3)"
exec "$PY" "$ROOT/archer/service.py" "$@"
