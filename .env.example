# Archer Configuration File
# Copy this file to .env and update with your settings

# ==============================================================================
# Email Configuration
# ==============================================================================

# Enable/disable email sending (set to 'true' to enable)
# When false, emails will be logged to console instead of being sent
EMAIL_ENABLED=false

# SMTP Server Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true

# SMTP Authentication
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password

# Email Sender Information
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Archer Security Platform

# Application Base URL (used for password reset links)
BASE_URL=http://localhost:8000

# ==============================================================================
# Database Configuration (Optional - defaults to data/archer.db)
# ==============================================================================

# DATABASE_PATH=data/archer.db

# ==============================================================================
# Session Configuration (Optional - uses defaults if not specified)
# ==============================================================================

# SESSION_DURATION_HOURS=16
# REMEMBER_ME_DURATION_DAYS=7

# ==============================================================================
# Security (Optional)
# ==============================================================================

# ENCRYPTION_KEY_PATH=data/encryption.key

# ==============================================================================
# Correlation Configuration
# ==============================================================================

# Minimum relevance threshold for correlation generation (0.0 - 1.0)
# Correlations with relevance scores below this threshold will be filtered out
# Default: 0.75 (75% relevance)
# Higher values = fewer but higher quality correlations
# Lower values = more correlations but potentially less relevant
CORRELATION_MIN_RELEVANCE=0.75

# Maximum number of correlations to generate
# Default: 250
# Limits the total number of correlations to prevent performance issues
CORRELATION_MAX_LIMIT=250

# ==============================================================================
# LLM Provider Configuration (AI Model Selection)
# ==============================================================================

# LLM Provider Selection
# Options: anthropic, openai, google, ollama
# Default: anthropic
LLM_PROVIDER=anthropic

# Optional: Override default model for the selected provider
# Provider-specific examples:
#   Anthropic: claude-sonnet-4-5-20250929, claude-opus-4-20241120
#   OpenAI: gpt-4o, gpt-4-turbo, gpt-4
#   Google: gemini-2.0-flash-exp, gemini-pro
#   Ollama: llama2, mistral, codellama
# LLM_MODEL=claude-sonnet-4-5-20250929

# ==============================================================================
# LLM API Keys
# ==============================================================================

# Anthropic Claude (Required for default provider)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Legacy variable (still supported for backward compatibility)
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# OpenAI GPT (Optional - requires: pip install openai)
# OPENAI_API_KEY=sk-your-key-here

# Google Gemini (Optional - requires: pip install google-generativeai)
# GOOGLE_API_KEY=AIza-your-key-here

# Ollama (Optional - runs locally, no API key needed)
# Ensure Ollama server is running: ollama serve
# Default server: http://localhost:11434

# ==============================================================================
# LLM Provider Usage Examples
# ==============================================================================

# Example 1: Cost-effective setup (Gemini - lowest cost)
#   LLM_PROVIDER=google
#   LLM_MODEL=gemini-2.0-flash-exp
#   GOOGLE_API_KEY=AIza-your-key-here

# Example 2: Privacy-focused setup (Ollama - 100% local)
#   LLM_PROVIDER=ollama
#   LLM_MODEL=llama2
#   (No API key needed - runs entirely locally)

# Example 3: High-quality setup (Claude - best reasoning)
#   LLM_PROVIDER=anthropic
#   LLM_MODEL=claude-sonnet-4-5-20250929
#   ANTHROPIC_API_KEY=sk-ant-your-key-here

# Example 4: Fast setup (GPT-4o - fastest response)
#   LLM_PROVIDER=openai
#   LLM_MODEL=gpt-4o
#   OPENAI_API_KEY=sk-your-key-here
