# Archer Configuration File
# Copy this file to .env and update with your settings

# ==============================================================================
# Email Configuration
# ==============================================================================

# Enable/disable email sending (set to 'true' to enable)
# When false, emails will be logged to console instead of being sent
EMAIL_ENABLED=false

# SMTP Server Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true

# SMTP Authentication
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password

# Email Sender Information
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Archer Security Platform

# Application Base URL (used for password reset links)
BASE_URL=http://localhost:8000

# ==============================================================================
# Database Configuration (Optional - defaults to data/archer.db)
# ==============================================================================

# DATABASE_PATH=data/archer.db

# ==============================================================================
# Session Configuration (Optional - uses defaults if not specified)
# ==============================================================================

# SESSION_DURATION_HOURS=16
# REMEMBER_ME_DURATION_DAYS=7

# ==============================================================================
# Security (Optional)
# ==============================================================================

# ENCRYPTION_KEY_PATH=data/encryption.key

# ==============================================================================
# Correlation Configuration
# ==============================================================================

# Minimum relevance threshold for correlation generation (0.0 - 1.0)
# Correlations with relevance scores below this threshold will be filtered out
# Default: 0.75 (75% relevance)
# Higher values = fewer but higher quality correlations
# Lower values = more correlations but potentially less relevant
CORRELATION_MIN_RELEVANCE=0.75

# Maximum number of correlations to generate
# Default: 250
# Limits the total number of correlations to prevent performance issues
CORRELATION_MAX_LIMIT=250
