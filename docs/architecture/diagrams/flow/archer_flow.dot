// Archer Architecture Flow - Updated November 2024
// Complete system architecture including all major features

digraph ArcherFlow {
  rankdir=TB;
  node [shape=box, style="filled,rounded", fillcolor="#f8f9fa", fontname="Helvetica", fontsize=10];
  edge [fontsize=9];

  // ============================================
  // USER INTERFACES
  // ============================================
  subgraph cluster_ui {
    label="User Interfaces";
    style=filled;
    fillcolor="#e6f0ff";
    fontsize=12;

    web_ui [label="Web UI\n(VirusTotal-style\nTabbed Interface)", shape=component, fillcolor="#4a90e2", fontcolor=white];
    cli [label="CLI\n(archer.py)", shape=component, fillcolor="#4a90e2", fontcolor=white];
    api_clients [label="External API Clients\n(SOAR, etc.)", shape=component, fillcolor="#4a90e2", fontcolor=white];
  }

  // ============================================
  // WEB PAGES
  // ============================================
  subgraph cluster_pages {
    label="Web Pages";
    style=filled;
    fillcolor="#fff1c6";
    fontsize=12;

    index [label="Home/Generate\n(/)", fillcolor="#ffe680"];
    results [label="Results\n(/results)", fillcolor="#ffe680"];
    progress [label="Progress\n(/progress)", fillcolor="#ffe680"];
    library [label="Library\n(/library)", fillcolor="#ffe680"];
    profile [label="Profile\n(/profile)", fillcolor="#ffe680"];
    profile_config [label="Config Tab\n(Correlation Params)", fillcolor="#ffeb99"];
    how_it_works [label="How It Works\n(/how-it-works)", fillcolor="#ffe680"];
    login [label="Login/Register\n(/login)", fillcolor="#ffe680"];
  }

  // ============================================
  // FASTAPI APPLICATION
  // ============================================
  subgraph cluster_app {
    label="FastAPI Application (archer/app.py)";
    style=filled;
    fillcolor="#e8ffe8";
    fontsize=12;

    // Core endpoints
    endpoint_generate [label="/generate\n(POST)", fillcolor="#90ee90"];
    endpoint_results [label="/results\n(GET)", fillcolor="#90ee90"];
    endpoint_progress [label="/progress\n(GET)", fillcolor="#90ee90"];
    endpoint_correlate [label="/correlate\n(POST)", fillcolor="#90ee90"];

    // Library endpoints
    endpoint_library [label="/api/library/*\n(CRUD)", fillcolor="#90ee90"];

    // Profile/Config endpoints
    endpoint_profile [label="/profile\n(GET/POST)", fillcolor="#90ee90"];
    endpoint_correlation_params [label="/api/correlation/params\n(GET/POST)", fillcolor="#90ee90"];

    // Auth endpoints
    endpoint_auth [label="/login, /logout\n/register", fillcolor="#90ee90"];

    // File upload
    endpoint_upload [label="/upload\n(File Analysis)", fillcolor="#90ee90"];

    // Company profiling
    endpoint_company [label="/api/company/profile\n(POST)", fillcolor="#90ee90"];
  }

  // ============================================
  // CORE SERVICES
  // ============================================
  subgraph cluster_services {
    label="Core Services";
    style=filled;
    fillcolor="#ffe8e8";
    fontsize=12;

    orchestrator [label="Orchestrator\n(archer.build.orchestrator)\nprocess_group()", fillcolor="#ff9999"];

    mitre_service [label="MITRE Service\n(archer.mitre)\nExtract procedures,\ntechniques, tactics", fillcolor="#ff9999"];

    correlation_engine [label="Correlation Engine\n(archer.genai.engine)\n- Score pairs (0-140)\n- Filter (threshold=40%)\n- Merge correlations\n- Generate JOIN queries", fillcolor="#ff9999"];

    detection_builder [label="Detection Builder\n(archer.build.detections)\nGenerate YAML detections", fillcolor="#ff9999"];

    osint_service [label="OSINT Integration\n(archer.build.osint_repos)\nElastic, Splunk, etc.", fillcolor="#ff9999"];

    validation_service [label="Validation Service\n(archer.build.platform_*)\nValidate queries", fillcolor="#ff9999"];

    auth_service [label="Auth Service\n(archer.database.*)\nBcrypt, MFA, Sessions", fillcolor="#ff9999"];
  }

  // ============================================
  // DATA STORAGE
  // ============================================
  subgraph cluster_data {
    label="Data Storage";
    style=filled;
    fillcolor="#f0f0f0";
    fontsize=12;

    // File storage
    generate_dir [label="data/groups/\n(Detection YAMLs)", shape=folder];
    correlate_dir [label="data/correlate/\n(Correlation JSONs)", shape=folder];
    progress_dir [label="data/progress/\n(Progress tracking)", shape=folder];
    cve_cache [label="data/cve_cache/\n(CVE data)", shape=folder];

    // Database
    database [label="data/archer.db\n(SQLite)\n- Users\n- Sessions\n- API Keys\n- Library\n- Audit Logs", shape=cylinder, fillcolor="#d0d0d0"];

    // Config files
    config_files [label="archer/config.py\narcher/genai/engine.py\n(Correlation params)", shape=note];

    // Mappings
    mappings [label="archer/mappings/\nSchema normalization\nField mappings", shape=folder];
  }

  // ============================================
  // EXTERNAL INTEGRATIONS
  // ============================================
  subgraph cluster_external {
    label="External Integrations";
    style=filled;
    fillcolor="#f3f3ff";
    fontsize=12;

    mitre_attack [label="MITRE ATT&CK\n(STIX Bundle)", shape=cylinder, fillcolor="#c8c8ff"];
    osint_repos [label="OSINT Repos\n(GitHub)\nElastic, Splunk, etc.", shape=cylinder, fillcolor="#c8c8ff"];
    cve_nvd [label="CVE/NVD\nVulnerability Data", shape=cylinder, fillcolor="#c8c8ff"];
    vectr [label="VECTR\n(Hunt Tracking)", shape=cylinder, fillcolor="#c8c8ff", style="dashed,filled"];
    siem_apis [label="SIEM APIs\n(MDE, Splunk)", shape=cylinder, fillcolor="#c8c8ff", style="dashed,filled"];
  }

  // ============================================
  // CONNECTIONS: UI to Pages
  // ============================================
  web_ui -> index [label="Navigate"];
  web_ui -> results [label="Navigate"];
  web_ui -> library [label="Navigate"];
  web_ui -> profile [label="Navigate"];
  web_ui -> how_it_works [label="Navigate"];
  web_ui -> login [label="Navigate"];

  profile -> profile_config [label="Config tab"];

  // ============================================
  // CONNECTIONS: Pages to Endpoints
  // ============================================
  index -> endpoint_generate [label="Submit group"];
  index -> endpoint_upload [label="Upload file"];
  index -> endpoint_company [label="Company profile"];

  results -> endpoint_results [label="GET results"];
  progress -> endpoint_progress [label="Poll status"];

  library -> endpoint_library [label="CRUD operations"];

  profile -> endpoint_profile [label="Update profile"];
  profile_config -> endpoint_correlation_params [label="Update params"];

  login -> endpoint_auth [label="Auth requests"];

  // ============================================
  // CONNECTIONS: Endpoints to Services
  // ============================================
  endpoint_generate -> orchestrator [label="process_group()"];
  endpoint_correlate -> correlation_engine [label="generate_correlations()"];
  endpoint_correlation_params -> config_files [label="Read/Write params"];

  endpoint_auth -> auth_service [label="Authenticate"];
  endpoint_library -> database [label="Query library"];
  endpoint_profile -> database [label="Query/Update user"];

  endpoint_upload -> mitre_service [label="Extract TTPs"];
  endpoint_company -> mitre_service [label="Profile threats"];

  // ============================================
  // CONNECTIONS: Services to Services
  // ============================================
  orchestrator -> mitre_service [label="Get procedures"];
  orchestrator -> detection_builder [label="Generate detections"];
  orchestrator -> correlation_engine [label="Build correlations"];
  orchestrator -> osint_service [label="OSINT enrichment"];
  orchestrator -> validation_service [label="Validate queries"];

  detection_builder -> mappings [label="Schema normalization"];
  validation_service -> mappings [label="Field validation"];

  // ============================================
  // CONNECTIONS: Services to Data
  // ============================================
  detection_builder -> generate_dir [label="Write YAMLs"];
  correlation_engine -> generate_dir [label="Read YAMLs"];
  correlation_engine -> correlate_dir [label="Write JSONs"];

  orchestrator -> progress_dir [label="Write progress"];
  endpoint_progress -> progress_dir [label="Read progress"];

  auth_service -> database [label="Users, sessions"];
  endpoint_library -> database [label="Library entries"];

  // ============================================
  // CONNECTIONS: External Data Sources
  // ============================================
  mitre_service -> mitre_attack [label="Download/Cache\nSTIX bundle"];
  osint_service -> osint_repos [label="Clone/Pull\ndetections"];
  endpoint_upload -> cve_nvd [label="Query CVE data\n(optional)"];

  // Optional integrations (dashed)
  orchestrator -> vectr [label="Export hunts", style=dashed];
  endpoint_profile -> siem_apis [label="Test queries", style=dashed];

  // ============================================
  // CLI Connections
  // ============================================
  cli -> orchestrator [label="Direct invocation"];
  cli -> correlation_engine [label="Direct invocation"];

  // ============================================
  // API Client Connections
  // ============================================
  api_clients -> endpoint_generate [label="HTTP POST"];
  api_clients -> endpoint_library [label="HTTP GET/POST"];
  api_clients -> endpoint_results [label="HTTP GET"];

  // ============================================
  // LAYOUT HINTS
  // ============================================
  {rank=same; web_ui; cli; api_clients}
  {rank=same; index; results; library; profile}
  {rank=same; mitre_attack; osint_repos; cve_nvd; vectr; siem_apis}
}
