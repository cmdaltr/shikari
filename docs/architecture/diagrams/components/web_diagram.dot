digraph ArcherWeb {
    rankdir=TB;
    node [shape=box, style="rounded,filled", fillcolor="#e8f0fe", fontname="Arial"];
    edge [color="#5f6368", fontname="Arial", fontsize=10];

    graph [bgcolor="transparent", pad="0.5", ranksep="0.8", nodesep="0.6"];

    // Browser layer
    subgraph cluster_browser {
        label="Browser (Frontend)";
        style=filled;
        fillcolor="#fff9c4";
        fontname="Arial Bold";

        html [label="HTML Templates\nindex.html, results.html\nlibrary.html, profile.html\nprogress.html, how_it_works.html\n\nJinja2 rendering"];
        js [label="JavaScript\nindex.js, progress.js\ntabs.js\n\nAJAX, real-time updates"];
        css [label="CSS Styling\nstyle.css, tabs.css\n\nVirusTotal-inspired theme"];
    }

    // FastAPI application layer
    subgraph cluster_fastapi {
        label="FastAPI Application (Python)";
        style=filled;
        fillcolor="#c8e6c9";
        fontname="Arial Bold";

        app [label="app.py\nMain Application\n\nFastAPI async handlers\nAuth middleware"];

        subgraph cluster_routes {
            label="API Routes";
            style=filled;
            fillcolor="#e8f5e9";

            route_gen [label="/generate\nStart detection\ngeneration"];
            route_upload [label="/upload\nFile upload &\nextraction"];
            route_library [label="/api/library/*\nCRUD operations\nLibrary management"];
            route_profile [label="/profile\nUser profile\n/api/correlation/params"];
            route_progress [label="/progress\nReal-time status"];
            route_auth [label="/login, /register\nAuthentication\nSession management"];
        }
    }

    // Processing layer (background)
    subgraph cluster_processing {
        label="Background Processing";
        style=filled;
        fillcolor="#e0e0e0";
        fontname="Arial Bold";

        orchestrator_web [label="Orchestrator\norchestrator.py\n\nAsync workflow\nNon-blocking execution"];
        file_proc [label="File Processor\nPDF, DOCX, CSV\nYARA, JSON\n\nExtracts IOCs/TTPs"];
        mitre_proc [label="MITRE Service\nmitre.py\n\nProcedures extraction\nTechnique mapping"];
        auth_proc [label="Auth Service\ndatabase.py\n\nBcrypt hashing\nMFA, Sessions"];
    }

    // Core engines
    subgraph cluster_engines {
        label="Detection Engines";
        style=filled;
        fillcolor="#b2dfdb";
        fontname="Arial Bold";

        gen_engine [label="Detection Builder\ndetections.py\n\nGenerate queries\nYAML output"];
        corr_engine [label="Correlation Engine\nengine.py\n\nScore pairs (0-140)\nFilter (threshold=40%)\nMerge correlations"];
        osint_engine [label="OSINT Integration\nosint_repos.py\n\nElastic, Splunk rules\nComparison"];
        validation_engine [label="Validation Service\nplatform_validator_v2.py\n\nSyntax checking\nField validation"];
    }

    // Progress tracking
    subgraph cluster_progress {
        label="Real-Time Progress";
        style=filled;
        fillcolor="#f8bbd0";
        fontname="Arial Bold";

        progress_track [label="Progress Tracker\nprogress.json\n\nAtomic writes\nNo race conditions"];
        websocket [label="WebSocket/Poll\nLive updates\n\n500ms refresh"];
    }

    // Storage layer
    subgraph cluster_storage {
        label="File Storage";
        style=filled;
        fillcolor="#ffccbc";
        fontname="Arial Bold";

        data_generate [label="data/groups/\nDetection YAMLs\nReady to deploy"];
        data_correlate [label="data/correlate/\nCorrelation JSONs\nMulti-stage detections"];
        data_uploads [label="data/uploads/\nUser files\nExtraction results"];
        database [label="data/archer.db\nSQLite Database\n\nUsers, Sessions\nAPI Keys, Library\nAudit Logs"];
    }

    // User interaction flow
    html -> js [label="DOM events"];
    css -> html [label="Styling"];
    js -> app [label="Fetch API\nJSON requests", color="#4285f4", style=bold];

    // Routing
    app -> route_gen;
    app -> route_upload;
    app -> route_library;
    app -> route_profile;
    app -> route_progress;
    app -> route_auth;

    // Route to processing
    route_gen -> orchestrator_web [label="Start workflow"];
    route_upload -> file_proc [label="Process file"];
    route_upload -> mitre_proc [label="Extract TTPs"];
    route_auth -> auth_proc [label="Authenticate"];
    route_library -> database [label="Query/Update"];
    route_profile -> database [label="Query/Update user"];

    // Processing to engines
    orchestrator_web -> gen_engine [label="Generate"];
    orchestrator_web -> corr_engine [label="Correlate"];
    orchestrator_web -> osint_engine [label="OSINT"];
    orchestrator_web -> validation_engine [label="Validate"];

    // Progress tracking
    gen_engine -> progress_track [label="Update status"];
    corr_engine -> progress_track [label="Update status"];
    progress_track -> websocket [label="Broadcast"];
    websocket -> js [label="Live updates", color="#4285f4", style=bold];

    // Storage
    gen_engine -> data_generate [label="Write YAMLs"];
    corr_engine -> data_correlate [label="Write JSONs"];
    file_proc -> data_uploads [label="Save uploads"];
    auth_proc -> database [label="Users, sessions"];

    // Results back to user
    data_generate -> route_progress [label="Serve files", style=dashed];
    data_correlate -> route_progress [label="Serve files", style=dashed];
    route_progress -> js [label="Download links", color="#4285f4"];

    // Legend
    legend [shape=plaintext, label=<
        <table border="0" cellborder="0" cellspacing="0">
        <tr><td align="left"><b>Web Architecture Features:</b></td></tr>
        <tr><td align="left">• Async/await for non-blocking I/O</td></tr>
        <tr><td align="left">• Real-time progress updates</td></tr>
        <tr><td align="left">• Background task processing</td></tr>
        <tr><td align="left">• RESTful API with authentication</td></tr>
        <tr><td align="left">• SQLite database for persistence</td></tr>
        <tr><td align="left">• Correlation parameter tuning (40%/60/20)</td></tr>
        </table>
    >];
}
