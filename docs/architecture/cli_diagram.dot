digraph ArcherCLI {
    rankdir=TB;
    node [shape=box, style="rounded,filled", fillcolor="#e8f0fe", fontname="Arial"];
    edge [color="#5f6368", fontname="Arial", fontsize=10];

    graph [bgcolor="transparent", pad="0.5", ranksep="0.8", nodesep="0.6"];

    // User input
    user [label="User/Script", shape=ellipse, fillcolor="#fff9c4", style="filled"];

    // CLI entry point
    cli [label="archer.py\nCLI Interface", fillcolor="#c8e6c9"];

    // Core modules
    subgraph cluster_core {
        label="Core Processing";
        style=filled;
        fillcolor="#e0e0e0";
        fontname="Arial Bold";

        mitre [label="MITRE Module\nenterprise.py\n\nLoads ATT&CK data\nMaps techniques to tactics"];
        learning [label="Query Learning\ndetections.py\n\nParses community queries\nExtracts patterns\nBuilds templates"];
        orchestrator [label="Orchestrator\norchestrator.py\n\nCoordinates workflow\nManages progress\nCalls generators"];
    }

    // Parser layer
    subgraph cluster_parsers {
        label="Query Parsers & Generators";
        style=filled;
        fillcolor="#c8e6c9";
        fontname="Arial Bold";

        splunk [label="Splunk Parser\nsplunk.py\n\nParses SPL syntax\nGenerates Splunk queries"];
        mde [label="MDE Parser\nmde.py\n\nParses KQL syntax\nGenerates MDE queries"];
        correlations [label="Correlation Engine\ncorrelations.py\n\nFinds related techniques\nCreates multi-stage detections"];
        semantics [label="Semantic Analyzer\nsemantics.py\n\nGroups by behavior\n(auth, network, file)"];
        validator [label="Query Validator\nvalidator.py\n\nSyntax validation\nPlatform checking"];
    }

    // Intelligence layer
    subgraph cluster_intelligence {
        label="Intelligence & Extraction";
        style=filled;
        fillcolor="#fff9c4";
        fontname="Arial Bold";

        file_intel [label="File Intelligence\nfile_intelligence.py\n\nExtracts IOCs\nExtracts TTPs\nSmart filtering"];
        blog_analyzer [label="Blog Analyzer\nblog_analyzer.py\n\nFetches blogs\nCleans HTML\nExtracts threat intel"];
    }

    // Visualization
    subgraph cluster_viz {
        label="Visualization";
        style=filled;
        fillcolor="#f8bbd0";
        fontname="Arial Bold";

        attack_flow [label="Attack Flow\nattack_flow.py\n\nGenerates flow diagrams\nCorrelation flows\nActor flows"];
    }

    // Data sources
    subgraph cluster_data {
        label="Data Sources";
        style=filled;
        fillcolor="#b2dfdb";
        fontname="Arial Bold";

        attack_data [label="MITRE ATT&CK\nenterprise-attack.json\n\n15,000+ techniques\n600+ groups"];
        repos [label="Community Repos\nSplunkSecurity/...\nSigma rules\n\n10,000+ queries"];
        cache [label="Template Cache\ndata/cache/\n\nPre-compiled templates\nFast generation"];
    }

    // Output
    subgraph cluster_output {
        label="Output";
        style=filled;
        fillcolor="#ffccbc";
        fontname="Arial Bold";

        yamls [label="Detection YAMLs\ndata/<group>/splunk/\ndata/<group>/mde/\n\nReady to deploy"];
        corr_files [label="Correlation JSONs\ndata/<group>/correlations/\n\nMulti-stage detections"];
        flow_files [label="Attack Flow JSONs\ndata/attack_flows/\n\nVisual diagrams"];
    }

    // Main workflow
    user -> cli [label="Group name"];
    cli -> orchestrator [label="Start generation"];
    orchestrator -> mitre [label="Lookup techniques"];
    orchestrator -> learning [label="Get templates"];

    mitre -> attack_data [label="Load data", style=dashed];
    learning -> repos [label="Parse queries", style=dashed];
    learning -> cache [label="Cache templates", style=dashed];

    orchestrator -> splunk [label="Generate Splunk"];
    orchestrator -> mde [label="Generate MDE"];
    orchestrator -> correlations [label="Find correlations"];
    orchestrator -> semantics [label="Group semantically"];
    orchestrator -> attack_flow [label="Generate flows"];

    splunk -> validator [label="Validate"];
    mde -> validator [label="Validate"];

    validator -> yamls [label="Write files"];
    correlations -> corr_files [label="Write JSON"];
    attack_flow -> flow_files [label="Write diagrams"];

    // Intelligence paths
    file_intel -> orchestrator [label="Extracted TTPs/IOCs", style=dashed, color="#ff6b6b"];
    blog_analyzer -> orchestrator [label="Blog intel", style=dashed, color="#ff6b6b"];

    // Legend
    legend [shape=plaintext, label=<
        <table border="0" cellborder="0" cellspacing="0">
        <tr><td align="left"><b>Speed Optimizations:</b></td></tr>
        <tr><td align="left">• Template caching (90% faster)</td></tr>
        <tr><td align="left">• Parallel parsing (4x speedup)</td></tr>
        <tr><td align="left">• Incremental generation</td></tr>
        <tr><td align="left">• Pre-compiled regex patterns</td></tr>
        </table>
    >];
}
